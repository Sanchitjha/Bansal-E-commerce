// Prisma schema for Luminary E-commerce backend
// Status/category/payment fields are plain strings validated at the API layer
// against the TS unions in src/types/index.ts (avoids Postgres enum churn).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  sku                String   @unique
  category           String
  subcategory        String
  brand              String
  shortDescription   String
  longDescription    String
  images             String[]
  mrp                Float
  sellingPrice       Float
  costPrice          Float
  discountPercent    Float
  gstRate            Float
  hsnCode            String
  stock              Int
  lowStockThreshold  Int
  weightKg           Float
  dimensionsCm       String?
  status             String   @default("active")
  isFeatured         Boolean  @default(false)
  isBestSeller       Boolean  @default(false)
  isNewArrival       Boolean  @default(false)
  isHomepagePriority Boolean  @default(false)
  priorityOrder      Int      @default(0)
  isBulkAvailable    Boolean  @default(false)
  bulkSlabs          Json     @default("[]")
  variants           Json     @default("[]")
  rating             Float    @default(0)
  reviewsCount       Int      @default(0)
  seoTitle           String?
  metaDescription    String?
  urlSlug            String   @unique
  keywords           String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  location  String
  rating    Int
  title     String
  content   String
  date      DateTime @default(now())
  verified  Boolean  @default(true)

  @@index([productId])
}

// One row per anonymous shopper, identified via an httpOnly cookie.
model CartSession {
  id               String   @id @default(cuid())
  activeCouponCode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items    CartItem[]
  wishlist WishlistItem[]
}

model CartItem {
  id                String      @id @default(cuid())
  sessionId         String
  session           CartSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int
  // '' means "no variant selected" — kept non-null so the compound unique index below
  // actually enforces uniqueness (Postgres treats every NULL in a unique index as distinct).
  selectedVariantId String      @default("")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([sessionId, productId, selectedVariantId])
}

model WishlistItem {
  id        String      @id @default(cuid())
  sessionId String
  session   CartSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([sessionId, productId])
}

model Coupon {
  id               String   @id @default(cuid())
  code             String   @unique
  type             String
  value            Float
  minOrderValue    Float    @default(0)
  maxDiscount      Float?
  firstOrderOnly   Boolean  @default(false)
  categorySpecific String?
  isActive         Boolean  @default(true)
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
}

model Order {
  id              String   @id
  date            DateTime @default(now())
  customerName    String
  phone           String
  email           String
  shippingAddress String
  city            String
  state           String
  pincode         String
  items           Json
  subtotal        Float
  discount        Float
  couponCode      String?
  taxableAmount   Float
  gstAmount       Float
  cgst            Float
  sgst            Float
  igst            Float
  shippingFee     Float
  totalAmount     Float
  paymentMethod   String
  paymentStatus   String
  orderStatus     String
  courier         String?
  trackingNumber  String?

  // Unguessable token that grants access to this order's invoice link.
  accessToken     String?
  // Razorpay order id (created at checkout) and payment id (set once paid).
  gatewayOrderId  String?
  paymentRef      String?

  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([email])
  @@index([phone])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  createdAt    DateTime @default(now())

  orders Order[]
}

// Failed-login counters, stored in the DB because serverless instances share no memory.
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

model BulkEnquiry {
  id           String   @id @default(cuid())
  name         String
  company      String
  mobile       String
  email        String
  productName  String
  quantity     Int
  expectedDate String
  message      String
  status       String   @default("New")
  createdAt    DateTime @default(now())
}

model HeroBanner {
  id             String  @id @default(cuid())
  title          String
  subtitle       String
  badge          String
  discountTag    String
  buttonText     String
  destinationUrl String
  imageUrl       String
  priority       Int
  isActive       Boolean @default(true)
  productId      String?
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminName String
  action    String
  timestamp DateTime @default(now())
  details   String?

  @@index([timestamp])
}

model SheetSyncLog {
  id        String   @id @default(cuid())
  sheetName String
  orderId   String?
  event     String
  timestamp DateTime @default(now())
  status    String   @default("Synced")
}

model SiteSettings {
  id                     String @id @default("singleton")
  websiteName            String
  logoText               String
  contactPhone           String
  contactEmail           String
  address                String
  whatsAppNumber         String
  freeShippingThreshold  Float
  defaultShippingCharge  Float
  lowStockAlertThreshold Int

  // Seller details used on invoices and to decide CGST+SGST (same state) vs IGST (other state).
  sellerState            String  @default("Maharashtra")
  gstin                  String  @default("")
  legalName              String  @default("")
  // Delivery rules: COD on/off, and comma-separated pincodes we cannot deliver to.
  codEnabled             Boolean @default(true)
  blockedPincodes        String  @default("")
}
